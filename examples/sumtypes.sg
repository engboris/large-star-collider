; this example is experimental
(use "milkyway/prelude.sg")

(spec direction
  [-north ok]
  [-south ok]
  [-west ok]
  [-east ok])

(object n +north) (::* n direction)

(spec result
  [(-ok X) ok] [(-error X) ok])

(object x (+ok a)) (::* x result)

(def get_ok
  [(-ok X) X]
  [(-error X) (+error X)])

(show (exec *#get_ok #x))
