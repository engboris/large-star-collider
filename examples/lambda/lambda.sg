; The general case follows the exemple linear_lambda.sg except that
; there is an additional variable Y used to represent a "copy
; identifier" for duplication (contraction).

; variable x (as argument)
; the 'Y' variable holds the non-linear potential
(object var_x [(x (exp X d)) (+arg (exp [l|X] Y))])

; identity function id = \x -> x
; the non-linear potential is suppressed with 'd' corresponding
; to Girard's dereliction
(object id [(+id (exp [l|X] d)) (+id [r|X])])

; left projection lproj = \x y -> x discarding its second argument
(object lproj {
  [(+lproj [l|X] w)] ; weakening
  [(lproj (exp [r l|X] d)) (+lproj [r r|X])]})

(object cut [(-lproj X) (-arg X)])  ; cut
(object out [(+arg [r|X]) (out X)]) ; output

; application (lproj x)
(show (exec *#lproj *#var_x *#cut @#out))

; duplicator omega = \x -> x x
(object omega
  [(+x (exp X [l|Y])) (+xout X)]            ; var x as function
  [(+x (exp X [r|Y])) (+arg (exp [l|X] Y))] ; var x as argument
  [(+arg [r|X]) (out X)] ; output
  [(-xout X) (-arg X)] ; cut
)
