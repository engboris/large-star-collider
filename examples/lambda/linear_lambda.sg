; It is possible to represent lambda terms by using their translation to
; proof-structures:
; - a free variable is an axiom;
; - an abstraction is a 'par' connecting a free variable;
; - an application connects a body and a tensor argument+output with a cut.
(use "../milkyway/prelude.sg")

; variable x
(object x_arg [(x X) (+arg [l X])])

; linear identity function id = \x -> x
(object id [(+id [l|X]) (+id [r|X])])

(object cut [(-id X) (-arg X)]) ; cut
(object out [(+arg [r|X]) (out X)]) ; output

; application (id x)
(show (exec *#id *#x_arg *#cut @#out))

; identity function as argument
(object id_arg [(ida [l|X]) (+arg [l r|X])])

(object cut [(-id X) (-arg X)]) ; cut
(object [(+arg [r|X]) (out X)]) ; output

; application (id id)
(show (exec *#id *#id_arg *#cut @#out))

; linear application type
(spec (lollipop A B)
  ; switching left
  { [(- (var A) X) (+parxy X)]
    [(- (var B) X)]
    [(-parxy X) ok]}
  ; switching right
  { [(- (var A) X)]
    [(- (var B) X) (+parxy X)]
    [(-parxy X) ok]})

(object adapter
  [(-id [l|X]) (+ (var x) X)]
  [(-id [r|X]) (+ (var y) X)])

; Testing type of 'id'
(object vehicle (exec #id #adapter))
(:: vehicle (lollipop x y))
